# ---------------------------------------------------------------------------
# ADAN NEXUS | CONNECT — copy to .env (never commit the real file)
# ---------------------------------------------------------------------------

# Application
ENVIRONMENT=development
SECRET_KEY=replace-with-openssl-rand-base64-48
PUBLIC_BASE_URL=http://localhost:8000
# Exact browser origins allowed to mutate. The UI is same-origin through the
# Next.js proxy, so in production list the public console origin here.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional suffix allow-list for ephemeral preview hosts (leave empty in production).
ALLOWED_ORIGIN_SUFFIXES=
LOG_LEVEL=INFO
LOG_JSON=true

# Bootstrap administrator (created once on first boot; change the password)
BOOTSTRAP_ADMIN_EMAIL=admin@adan.local
BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password-min-10-chars
BOOTSTRAP_ADMIN_NAME=Nexus Operator

# Self-service signup (creates read-only operators only)
ALLOW_REGISTRATION=false
REGISTER_RATE_LIMIT=5

# Database: SQLite fallback for local development.
# docker-compose overrides DATABASE_URL with PostgreSQL automatically.
DATABASE_URL=sqlite:///./data/nexus.db
DATABASE_AUTO_CREATE=true

# PostgreSQL (docker-compose sets these; DATABASE_URL above wins)
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexus

# Redis (optional; in-memory fallback is used when absent)
REDIS_URL=redis://redis:6379/0

# Ingestion / scheduling (exactly one scheduler: the worker in Docker)
EMBEDDED_WORKER=false
INGESTION_ENABLED=true
INGESTION_UPSTREAM_ONLY=true
INGESTION_INTERVAL_MINUTES=60
INGESTION_JITTER_SECONDS=180
SOURCE_TIMEOUT_SECONDS=25
SOURCE_MAX_BYTES=8388608
SOURCE_MAX_RETRIES=2
ALLOW_PRIVATE_SOURCE_HOSTS=false

# Publication (local mirror only; GitHub Actions stays authoritative)
PUBLISH_MODE=local
PUBLISH_DIR=/app/data/published

# Health testing
HEALTH_AGENT_LABEL=primary-agent
HEALTH_AGENT_REGION=unspecified (no geo verification)
HEALTH_CONCURRENCY=8
HEALTH_TIMEOUT_SECONDS=3
HEALTH_MAX_BATCH=50
HEALTH_ALLOW_TCP=false
# Comma-separated PUBLIC CIDRs you own or are authorized to test. Empty disables TCP.
HEALTH_AUTHORIZED_CIDRS=

# Existing public bank (read-only visibility)
UPSTREAM_ENABLED=true
UPSTREAM_REPO=Adan03ac/ADAN-V2Ray-Free-Pack
UPSTREAM_BRANCH=main
GITHUB_TOKEN=

# Cloudflare (optional; deployments are NOT implemented)
CLOUDFLARE_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Frontend (Next.js server-side proxy to the API)
API_PROXY_TARGET=http://backend:8000
